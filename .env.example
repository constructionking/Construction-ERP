# Copy to .env and adjust.
DATABASE_URL="postgresql://erp:erp_dev_password@localhost:5432/construction_erp"

# 32+ char random secret for session JWT signing (openssl rand -base64 48)
AUTH_SECRET="change-me-to-a-long-random-secret-string-please"

# Storage: "local" (dev) or "s3"
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
# S3 settings (used when STORAGE_DRIVER=s3; works with MinIO/R2/AWS)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="construction-erp"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Claude API for photo progress analysis + measurement book anomaly assist.
# Leave empty to disable AI jobs (app works fully without them).
ANTHROPIC_API_KEY=""

# Site business-day close time, IST (used by amendment windows)
DAY_CLOSE_TZ_OFFSET_MINUTES="330"
