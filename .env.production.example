# -----------------------------------------------------------------------------
# Construction ERP — PRODUCTION environment.
#
# setup.sh generates a real .env from this template (with strong secrets). Copy
# it manually only if you are configuring by hand:  cp .env.production.example .env
# NEVER commit the real .env — it is gitignored.
# -----------------------------------------------------------------------------

NODE_ENV=production

# The public hostname Caddy serves + fetches TLS for. Free URL or your domain:
#   203.0.113.10.sslip.io   |   yoursite.duckdns.org   |   erp.yourcompany.com
APP_HOST=CHANGE_ME.sslip.io
# Email for Let's Encrypt expiry notices (optional but recommended).
ACME_EMAIL=

# --- Database (Postgres runs in the compose stack) ---------------------------
POSTGRES_USER=erp
# Use a long random value:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM
POSTGRES_DB=construction_erp
# Host is the compose service name 'postgres'. Must match the three vars above.
DATABASE_URL=postgresql://erp:CHANGE_ME_STRONG_RANDOM@postgres:5432/construction_erp

# --- Auth --------------------------------------------------------------------
# 32+ char random secret for JWT signing:  openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_LONG_RANDOM_STRING

# --- Storage (owner chose on-server for now; see DEPLOY.md data-loss note) ----
STORAGE_DRIVER=local
STORAGE_DIR=/app/storage
# When migrating to Cloudflare R2 / S3 later, set STORAGE_DRIVER=s3 and fill:
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=construction-erp
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Security / proxy --------------------------------------------------------
# Caddy sets X-Real-IP to the true client IP for login rate-limiting.
TRUSTED_IP_HEADER=x-real-ip

# --- Business rules ----------------------------------------------------------
# IST offset (minutes) for the 23:59 day-close gate. 330 = IST. Leave as-is.
DAY_CLOSE_TZ_OFFSET_MINUTES=330

# --- Web push (PWA notifications) --------------------------------------------
# Generate:  npx web-push generate-vapid-keys
# Leave empty to disable push (in-app notifications still work).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourcompany.com

# --- AI (optional) -----------------------------------------------------------
# Claude API for photo-progress estimates + measurement-book anomaly assist.
# Leave empty to disable AI jobs (app works fully without them).
ANTHROPIC_API_KEY=
