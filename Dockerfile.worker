# ---------------------------------------------------------------------------
# Construction ERP — Node worker image.
#
# Runs the pg-boss background worker (`pnpm worker`): day-close (23:59 IST),
# schedule/forecast, audit sweep, AI jobs, and the 6 pm consumption reminder.
#
# The same image is reused for one-off admin commands, because it carries the
# full toolchain (tsx + Prisma CLI + source + tsconfig path aliases):
#   - prisma migrate deploy          (apply migrations + immutability triggers)
#   - pnpm tsx scripts/bootstrap-owner.ts   (create the first owner)
#   - scripts/backup.sh / restore.sh (pg_dump lives in the postgres client)
# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim

# openssl for Prisma; postgresql-client gives pg_dump/psql for backups/restore.
RUN apt-get update && apt-get install -y --no-install-recommends \
      openssl ca-certificates postgresql-client tar gzip \
  && rm -rf /var/lib/apt/lists/*
# Global pnpm install (not corepack): works identically for the non-root
# runtime user, with no per-user cache or network needed at container start.
RUN npm install -g pnpm@9
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Full install (tsx + prisma CLI are devDependencies the worker needs).
# --prod=false: NODE_ENV=production would otherwise make pnpm skip dev deps.
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile --prod=false

COPY . .
RUN pnpm prisma generate

# Run as the same non-root uid as the web image (1001) so files the two
# containers share on the storage volume stay mutually readable/writable.
RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --create-home --uid 1001 --gid nodejs nextjs \
  && mkdir -p /app/storage && chown -R nextjs:nodejs /app/storage
USER nextjs

CMD ["pnpm", "worker"]
